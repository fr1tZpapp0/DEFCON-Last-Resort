<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" width="2048.00" height="996.796" viewBox="-180.000 -87.6091 360.000 175.218" version="1.1">
	<title>Blank world map</title>
	<desc>
		A map of the world with the top-level administrative divisions for some countries shown. De facto borders as of 2022 are taken from <a href="http://www.naturalearthdata.com/">Natural Earth</a>. Major lakes overlaid. Equal Earth projection.
	</desc>
	<style type="text/css">
		/*
		 * color in provinces here by inserting their or their countries&#39; ISO 3166 A2 codes. for example:
		 * (color Alberta, Canada in red)
		 * .CA-AB {
		 * 	fill:#ff0000;
		 * }
		 * (color all of Brazil in green)
		 * .BR {
		 * 	fill:#00ff00;
		 * }
		 */
		/* top-level administrative divisions of large countries */
		.province {
			fill:#c0c0c0; /* gray */
			stroke:#ffffff;
			stroke-width:.05;
		}
		/* countries whose divisions are not shown */
		.country {
			fill:#c0c0c0; /* gray */
			stroke:#ffffff;
			stroke-width:.15;
		}
		/* thick outline for countries whose divisions are shown */
		.country-outline {
			fill:none;
			stroke:#ffffff;
			stroke-width:.15;
		}
		/* ocean and lakes */
		.water {
			fill:#ffffff;
			stroke:none;
		}
	</style>
